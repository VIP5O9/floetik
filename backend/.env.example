# Copier en .env et adapter.

# Obligatoire, sans valeur par défaut : le site refuse de démarrer sans elle.
# Générer une valeur longue et aléatoire, propre à cette installation :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# False en production : c'est ce seul réglage qui déclenche HTTPS obligatoire,
# HSTS et les cookies « secure ».
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — les extensions unaccent et pg_trgm sont requises
# (créées par la migration 0002, exige un rôle superutilisateur).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/floetik

# Sauvegardes du corpus : python manage.py export_corpus
CORPUS_EXPORT_DIR=./backups

# Répertoire des journaux (floetik.log, tournant sur 5 fichiers de 10 Mo).
LOG_DIR=./logs

# Production, derrière un proxy TLS : sans cette ligne Django rejette les POST
# de l'admin et la connexion échoue sans message clair. Schéma + hôte.
# CSRF_TRUSTED_ORIGINS=https://floetik.ht,https://www.floetik.ht

# Destinataires des rapports d'erreur 500. Vide = pas de courriel, le fichier
# de journal reste la trace de référence.
# ADMINS=Florentz Charles <florentz@exemple.ht>
