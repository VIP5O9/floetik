# Copier en .env et adapter.
SECRET_KEY=change-moi-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — les extensions unaccent et pg_trgm sont requises
# (créées par la migration 0002, exige un rôle superutilisateur).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/floetik

# Sauvegardes du corpus : python manage.py export_corpus
CORPUS_EXPORT_DIR=./backups
